    <!-- Latest-row pick per (emission, e2e) per response table, single window
         pass. Prg-12 semantics preserved: a resolved (emission_id) row outranks
         every legacy twin (resolved DESC sorts first), then max created_at with
         response_file as the deterministic tiebreaker. Legacy NULL-emission rows
         bind through the globally unique outbound identity (orgnl_msg_id =
         crw_emission.outbound_msg_id, uq_emission_outbound_msg), exactly the v2
         legacy arm. The no-emission family fallback stays in ext_tx_status. -->
    <changeSet id="003-isr-pick-view" author="dcre" runOnChange="true">
        <createView viewName="prg_isr_pick" replaceIfExists="true"><![CDATA[
            SELECT u.emission_id, u.e2e, u.status
            FROM (SELECT c.emission_id, c.e2e, c.status,
                         row_number() OVER (PARTITION BY c.emission_id, c.e2e
                                            ORDER BY c.resolved DESC, c.created_at DESC,
                                                     c.response_file DESC) AS pick_rank
                  FROM (SELECT r.emission_id, r.e2e, r.status, true AS resolved,
                               r.created_at, r.response_file
                        FROM isr_resp r
                        WHERE r.emission_id IS NOT NULL
                        UNION ALL
                        SELECT em.id, r.e2e, r.status, false, r.created_at, r.response_file
                        FROM isr_resp r
                        JOIN crw_emission em ON em.outbound_msg_id = r.orgnl_msg_id
                        WHERE r.emission_id IS NULL) AS c) AS u
            WHERE u.pick_rank = 1
        ]]></createView>
    </changeSet>

    <changeSet id="003-sbsr-pick-view" author="dcre" runOnChange="true">
        <createView viewName="prg_sbsr_pick" replaceIfExists="true"><![CDATA[
            SELECT u.emission_id, u.e2e, u.status
            FROM (SELECT c.emission_id, c.e2e, c.status,
                         row_number() OVER (PARTITION BY c.emission_id, c.e2e
                                            ORDER BY c.resolved DESC, c.created_at DESC,
                                                     c.response_file DESC) AS pick_rank
                  FROM (SELECT r.emission_id, r.e2e, r.status, true AS resolved,
                               r.created_at, r.response_file
                        FROM sbsr_resp r
                        WHERE r.emission_id IS NOT NULL
                        UNION ALL
                        SELECT em.id, r.e2e, r.status, false, r.created_at, r.response_file
                        FROM sbsr_resp r
                        JOIN crw_emission em ON em.outbound_msg_id = r.orgnl_msg_id
                        WHERE r.emission_id IS NULL) AS c) AS u
            WHERE u.pick_rank = 1
        ]]></createView>
    </changeSet>

    <changeSet id="003-pbsr-pick-view" author="dcre" runOnChange="true">
