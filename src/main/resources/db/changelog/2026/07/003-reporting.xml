<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- BOOTSTRAP-ORDER GUARD (SCRUM-55, same contract as 001-bootstrap-sources-prg):
         PRG is clock-launched and may run on a fresh DB before CRW and the readers
         ever executed, so every NEW view source is pre-created/patched here with
         MARK_RAN schema-state guards using the owners' EXACT column sets and
         constraint/index names (CRW 001-crw.xml + 003-split.xml, IXR/SXR/PXR
         003-emission-fk). Whichever service runs first wins; the other side's
         guarded changesets MARK_RAN. Per-service liquibase history keeps this safe. -->

    <changeSet id="003-bootstrap-emission-group-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="crw_emission_group"/></not></preConditions>
        <createTable tableName="crw_emission_group">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="source_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="run_date" type="DATE"><constraints nullable="false"/></column>
            <column name="applied_max" type="INT"><constraints nullable="false"/></column>
            <column name="total_tx" type="BIGINT"><constraints nullable="false"/></column>
            <column name="total_amount" type="DECIMAL(18,2)"><constraints nullable="false"/></column>
            <column name="expected_batch_count" type="INT"><constraints nullable="false"/></column>
            <column name="split" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="crw_emission_group" columnNames="arrival_id, run_date" constraintName="uq_emission_group_arrival_run"/>
        <addUniqueConstraint tableName="crw_emission_group" columnNames="client, source_msg_id, run_date" constraintName="uq_emission_group_client_msg_run"/>
    </changeSet>

    <!-- Fresh-DB path: the FINAL batch-grain shape (CRW 001 + 003 combined). CRW's own
         guarded changesets converge on this state without re-executing. -->
    <changeSet id="003-bootstrap-emission-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="crw_emission"/></not></preConditions>
        <createTable tableName="crw_emission">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="run_date" type="DATE"><constraints nullable="false"/></column>
            <column name="file_name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="group_id" type="UUID"/>
            <column name="batch_ordinal" type="INT" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="outbound_msg_id" type="VARCHAR(64)"/>
            <column name="tx_count" type="BIGINT"/>
            <column name="control_sum" type="DECIMAL(18,2)"/>
            <column name="visible_at" type="TIMESTAMPTZ"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="crw_emission" columnNames="arrival_id, run_date, batch_ordinal" constraintName="uq_emission_arrival_run_ordinal"/>
        <createIndex tableName="crw_emission" indexName="uq_emission_outbound_msg" unique="true">
            <column name="outbound_msg_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-bootstrap-emission-member-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="crw_emission_member"/></not></preConditions>
        <createTable tableName="crw_emission_member">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="emission_id" type="UUID"><constraints nullable="false"/></column>
            <column name="sequence" type="INT"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="amount" type="DECIMAL(18,2)"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <!-- CRDB auto-name of CRW 001's inline UNIQUE, kept identical for state parity. -->
        <addUniqueConstraint tableName="crw_emission_member" columnNames="emission_id, sequence" constraintName="crw_emission_member_emission_id_sequence_key"/>
    </changeSet>

    <!-- Upgrade path: CRW 001 ran (pre-split table) but CRW 003 has not; the v2 view
         needs the batch columns. Constraint surgery stays owner-managed in CRW 003. -->
    <changeSet id="003-patch-emission-split-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="crw_emission" columnName="batch_ordinal"/></not></preConditions>
        <addColumn tableName="crw_emission">
            <column name="group_id" type="UUID"/>
            <column name="batch_ordinal" type="INT" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="outbound_msg_id" type="VARCHAR(64)"/>
            <column name="tx_count" type="BIGINT"/>
            <column name="control_sum" type="DECIMAL(18,2)"/>
            <column name="visible_at" type="TIMESTAMPTZ"/>
        </addColumn>
    </changeSet>

    <changeSet id="003-isr-emission-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="isr_resp" columnName="emission_id"/></not></preConditions>
        <addColumn tableName="isr_resp"><column name="emission_id" type="UUID"/></addColumn>
        <createIndex tableName="isr_resp" indexName="ix_isr_emission"><column name="emission_id"/></createIndex>
    </changeSet>

    <changeSet id="003-sbsr-emission-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="sbsr_resp" columnName="emission_id"/></not></preConditions>
        <addColumn tableName="sbsr_resp"><column name="emission_id" type="UUID"/></addColumn>
        <createIndex tableName="sbsr_resp" indexName="ix_sbsr_emission"><column name="emission_id"/></createIndex>
    </changeSet>

    <changeSet id="003-pbsr-emission-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="pbsr_resp" columnName="emission_id"/></not></preConditions>
        <addColumn tableName="pbsr_resp"><column name="emission_id" type="UUID"/></addColumn>
        <createIndex tableName="pbsr_resp" indexName="ix_pbsr_emission"><column name="emission_id"/></createIndex>
    </changeSet>

    <!-- R-21: status classes live in a reference table, never enums. -->
    <changeSet id="003-status-class" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="prg_status_class"/></not></preConditions>
        <createTable tableName="prg_status_class">
            <column name="code" type="VARCHAR(8)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="terminal" type="BOOLEAN"><constraints nullable="false"/></column>
        </createTable>
        <insert tableName="prg_status_class"><column name="code" value="ACSC"/><column name="terminal" valueBoolean="true"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="ACCC"/><column name="terminal" valueBoolean="true"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="RJCT"/><column name="terminal" valueBoolean="true"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="CANC"/><column name="terminal" valueBoolean="true"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="ACSP"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="ACTC"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="ACCP"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="ACFC"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="RCVD"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="PDNG"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="PART"/><column name="terminal" valueBoolean="false"/></insert>
        <insert tableName="prg_status_class"><column name="code" value="PATC"/><column name="terminal" valueBoolean="false"/></insert>
        <!-- ACWC/ACWP deliberately ABSENT: unclassified => interim via LEFT JOIN + COALESCE(false) (A-56). -->
    </changeSet>

    <changeSet id="003-prg-report" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="prg_report"/></not></preConditions>
        <createTable tableName="prg_report">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="report_type" type="VARCHAR(12)"><constraints nullable="false"/></column>
            <column name="trigger_kind" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="window_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="parent_source_msg_id" type="VARCHAR(35)"/>
            <column name="file_name" type="VARCHAR(128)"><constraints nullable="false" unique="true"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="003-prg-delivery-ledger" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="prg_delivery_ledger"/></not></preConditions>
        <createTable tableName="prg_delivery_ledger">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="report_id" type="UUID"><constraints nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="manual_ref" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="prg_delivery_ledger" indexName="ix_ledger_report"><column name="report_id"/></createIndex>
    </changeSet>

    <changeSet id="003-ledger-auto-guard" author="dcre">
        <!-- LIQUIBASE-SQL-EXCEPTION: a PARTIAL unique index (WHERE clause) has no typed
             Liquibase tag; the auto-send guard must exclude manual_ref rows so manual
             overrides bypass the guard while still being ledgered. -->
        <sql>CREATE UNIQUE INDEX IF NOT EXISTS uq_ledger_auto ON prg_delivery_ledger (client, e2e, status) WHERE manual_ref IS NULL;</sql>
    </changeSet>

    <!-- ext_tx_status v2: batch-scoped response joins close the A-40 cross-arrival
         e2e cross-link. CRDB CREATE OR REPLACE VIEW cannot reorder/insert columns,
         so v1 (001's 002-ext-tx-status-prg) is dropped first. Responses with
         emission_id NULL (reader fail-open ingest, pre-split legacy rows) still
         join by bare e2e: those statuses stay truth even when CRW's registry is
         behind (spec section 6). -->
    <changeSet id="003-drop-ext-tx-status-v1" author="dcre">
        <preConditions onFail="MARK_RAN"><viewExists viewName="ext_tx_status"/></preConditions>
        <dropView viewName="ext_tx_status"/>
    </changeSet>

    <changeSet id="003-ext-tx-status-v2" author="dcre">
        <createView viewName="ext_tx_status" replaceIfExists="true"><![CDATA[
            SELECT t.arrival_id, t.sequence, t.e2e, h.client_token AS client,
                   em.outbound_msg_id, em.id AS emission_id, g.source_msg_id,
                   COALESCE(p.status, sb.status, i.status,
                            CASE WHEN v.outcome = 'PASS' THEN 'CTV_PASS' ELSE v.outcome END) AS status,
                   COALESCE(sc.terminal, false) AS terminal,
                   CASE WHEN p.e2e IS NOT NULL THEN 4 WHEN sb.e2e IS NOT NULL THEN 3
                        WHEN i.e2e IS NOT NULL THEN 2 ELSE 1 END AS stage_rank
            FROM tx_entry t
            JOIN tx_header h ON h.arrival_id = t.arrival_id
            LEFT JOIN validation_log v ON v.arrival_id = t.arrival_id AND v.sequence = t.sequence
            LEFT JOIN crw_emission em ON em.arrival_id = t.arrival_id
                   AND EXISTS (SELECT 1 FROM crw_emission_member m
                               WHERE m.emission_id = em.id AND m.sequence = t.sequence)
            LEFT JOIN crw_emission_group g ON g.id = em.group_id
            LEFT JOIN isr_resp  i  ON i.e2e  = t.e2e AND (i.emission_id  = em.id OR i.emission_id  IS NULL)
            LEFT JOIN sbsr_resp sb ON sb.e2e = t.e2e AND (sb.emission_id = em.id OR sb.emission_id IS NULL)
            LEFT JOIN pbsr_resp p  ON p.e2e  = t.e2e AND (p.emission_id  = em.id OR p.emission_id  IS NULL)
            LEFT JOIN prg_status_class sc ON sc.code = COALESCE(p.status, sb.status, i.status)
        ]]></createView>
    </changeSet>

    <!-- Due parents for the AGT trigger scan. Ratified semantics (plan Task 9, the
         deliberately-unfrozen block; ReportingSchemaIT case (c) is the contract):
         COMPLETE = every member of every batch of the parent is terminal (reports
         immediately); IDLE = newest batch-correlated response older than the 120s
         debounce (zero responses = debounce never started, not due); BOTH require
         at least one (client, e2e, status) tuple absent from the auto ledger rows.
         Bounded: everything correlates from crw_emission_group, never the whole
         tx_entry history. -->
    <changeSet id="003-report-due-view" author="dcre">
        <createView viewName="prg_report_due" replaceIfExists="true"><![CDATA[
            SELECT g.client, g.source_msg_id,
                   CASE WHEN NOT EXISTS (SELECT 1 FROM ext_tx_status xc
                                         WHERE xc.arrival_id = g.arrival_id
                                           AND xc.emission_id IS NOT NULL AND NOT xc.terminal)
                        THEN 'COMPLETE' ELSE 'IDLE' END AS reason
            FROM crw_emission_group g
            WHERE EXISTS (SELECT 1 FROM ext_tx_status xd
                          WHERE xd.arrival_id = g.arrival_id
                            AND xd.emission_id IS NOT NULL AND xd.status IS NOT NULL
                            AND NOT EXISTS (SELECT 1 FROM prg_delivery_ledger l
                                            WHERE l.client = xd.client AND l.e2e = xd.e2e
                                              AND l.status = xd.status AND l.manual_ref IS NULL))
              AND (NOT EXISTS (SELECT 1 FROM ext_tx_status xc
                               WHERE xc.arrival_id = g.arrival_id
                                 AND xc.emission_id IS NOT NULL AND NOT xc.terminal)
                   OR COALESCE((SELECT max(r.updated_at)
                                FROM (SELECT r1.updated_at, r1.emission_id FROM isr_resp r1
                                      UNION ALL SELECT r2.updated_at, r2.emission_id FROM sbsr_resp r2
                                      UNION ALL SELECT r3.updated_at, r3.emission_id FROM pbsr_resp r3) r
                                JOIN crw_emission e ON e.id = r.emission_id
                                WHERE e.group_id = g.id), now()) < now() - INTERVAL '120 seconds')
        ]]></createView>
    </changeSet>

    <changeSet id="003-sla-pending-view" author="dcre">
        <createView viewName="prg_sla_pending" replaceIfExists="true"><![CDATA[
            SELECT g.client, x.e2e, em.outbound_msg_id, em.visible_at,
                   EXTRACT(EPOCH FROM (now() - em.visible_at)) / 3600 AS age_hours
            FROM crw_emission em
            JOIN crw_emission_group g ON g.id = em.group_id
            JOIN crw_emission_member m ON m.emission_id = em.id
            JOIN ext_tx_status x ON x.arrival_id = em.arrival_id AND x.e2e = m.e2e
            WHERE em.state = 'VISIBLE' AND em.visible_at IS NOT NULL AND NOT x.terminal
        ]]></createView>
    </changeSet>

</databaseChangeLog>
