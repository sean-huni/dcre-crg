    <!-- BOOTSTRAP-ORDER GUARD (SCRUM-55, same contract as 001-bootstrap-sources-prg):
         PRG is clock-launched and may run on a fresh DB before CRW and the readers
         ever executed, so every NEW view source is pre-created/patched here with
         MARK_RAN schema-state guards using the owners' EXACT column sets and
         constraint/index names (CRW 001-crw.xml + 003-split.xml, IXR/SXR/PXR
         003-emission-fk). Whichever service runs first wins; the other side's
         guarded changesets MARK_RAN. Per-service liquibase history keeps this safe. -->

    <changeSet id="003-bootstrap-emission-group-prg" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="crw_emission_group"/></not></preConditions>
        <createTable tableName="crw_emission_group">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="source_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="run_date" type="DATE"><constraints nullable="false"/></column>
            <column name="applied_max" type="INT"><constraints nullable="false"/></column>
            <column name="total_tx" type="BIGINT"><constraints nullable="false"/></column>
            <column name="total_amount" type="DECIMAL(18,2)"><constraints nullable="false"/></column>
            <column name="expected_batch_count" type="INT"><constraints nullable="false"/></column>
            <column name="split" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="crw_emission_group" columnNames="arrival_id, run_date" constraintName="uq_emission_group_arrival_run"/>
        <addUniqueConstraint tableName="crw_emission_group" columnNames="client, source_msg_id, run_date" constraintName="uq_emission_group_client_msg_run"/>
    </changeSet>

