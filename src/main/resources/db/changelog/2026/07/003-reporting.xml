    <!-- ext_tx_status v3: identical columns and semantics to v2 (batch-scoped
         A-40 guard, prg-12 latest-row picks, legacy outbound binding, the
         no-emission family fallback), restructured set-based for the SCRUM-55
         perf fix. The three response joins read the pick views; the family
         fallback matches ONLY arrivals with no emission at all and stays inside
         the parent identity family (orgnl_msg_id = parent MsgId or a split
         child MsgId_N), with its latest-row selection scoped per (family, e2e).
         CRDB CREATE OR REPLACE VIEW cannot reorder/insert columns, so v1
         (001's 002-ext-tx-status-prg) is dropped first (v3 keeps v2's exact
         column list, so v2 -> v3 replaces in place). -->
    <changeSet id="003-drop-ext-tx-status-v1" author="dcre">
        <preConditions onFail="MARK_RAN"><viewExists viewName="ext_tx_status"/></preConditions>
        <dropView viewName="ext_tx_status"/>
    </changeSet>

    <changeSet id="003-ext-tx-status-v2" author="dcre" runOnChange="true">
        <createView viewName="ext_tx_status" replaceIfExists="true"><![CDATA[
            WITH member_emission AS (
                    SELECT m.sequence, e.arrival_id, e.id AS emission_id, e.group_id,
                           e.outbound_msg_id
                    FROM crw_emission_member m
                    JOIN crw_emission e ON e.id = m.emission_id
            ),
            isr_fam AS (
                    SELECT h2.arrival_id, r.e2e, r.status,
                           row_number() OVER (PARTITION BY h2.arrival_id, r.e2e
                                              ORDER BY r.created_at DESC,
                                                       r.response_file DESC) AS rn
                    FROM isr_resp r
                    JOIN tx_header h2 ON r.orgnl_msg_id = h2.msg_id
                                      OR r.orgnl_msg_id LIKE h2.msg_id || '\_%'
                    WHERE r.emission_id IS NULL
                      AND NOT EXISTS (SELECT 1 FROM crw_emission pe
                                      WHERE pe.arrival_id = h2.arrival_id)
            ),
            sbsr_fam AS (
                    SELECT h2.arrival_id, r.e2e, r.status,
                           row_number() OVER (PARTITION BY h2.arrival_id, r.e2e
                                              ORDER BY r.created_at DESC,
                                                       r.response_file DESC) AS rn
                    FROM sbsr_resp r
                    JOIN tx_header h2 ON r.orgnl_msg_id = h2.msg_id
                                      OR r.orgnl_msg_id LIKE h2.msg_id || '\_%'
                    WHERE r.emission_id IS NULL
                      AND NOT EXISTS (SELECT 1 FROM crw_emission pe
                                      WHERE pe.arrival_id = h2.arrival_id)
            ),
            pbsr_fam AS (
                    SELECT h2.arrival_id, r.e2e, r.status,
                           row_number() OVER (PARTITION BY h2.arrival_id, r.e2e
                                              ORDER BY r.created_at DESC,
                                                       r.response_file DESC) AS rn
                    FROM pbsr_resp r
                    JOIN tx_header h2 ON r.orgnl_msg_id = h2.msg_id
                                      OR r.orgnl_msg_id LIKE h2.msg_id || '\_%'
                    WHERE r.emission_id IS NULL
                      AND NOT EXISTS (SELECT 1 FROM crw_emission pe
                                      WHERE pe.arrival_id = h2.arrival_id)
            )
            SELECT t.arrival_id, t.sequence, t.e2e, h.client_token AS client,
                   me.outbound_msg_id, me.emission_id, g.source_msg_id,
                   COALESCE(pp.status, pf.status, sp.status, sf.status, ip.status, ifm.status,
                            CASE WHEN v.outcome = 'PASS' THEN 'CTV_PASS' ELSE v.outcome END) AS status,
                   COALESCE(sc.terminal, false) AS terminal,
                   CASE WHEN COALESCE(pp.status, pf.status) IS NOT NULL THEN 4
                        WHEN COALESCE(sp.status, sf.status) IS NOT NULL THEN 3
                        WHEN COALESCE(ip.status, ifm.status) IS NOT NULL THEN 2
                        ELSE 1 END AS stage_rank
            FROM tx_entry t
            JOIN tx_header h ON h.arrival_id = t.arrival_id
            LEFT JOIN validation_log v ON v.arrival_id = t.arrival_id AND v.sequence = t.sequence
            LEFT JOIN member_emission me ON me.arrival_id = t.arrival_id AND me.sequence = t.sequence
            LEFT JOIN crw_emission_group g ON g.id = me.group_id
            LEFT JOIN prg_isr_pick  ip ON ip.emission_id = me.emission_id AND ip.e2e = t.e2e
            LEFT JOIN prg_sbsr_pick sp ON sp.emission_id = me.emission_id AND sp.e2e = t.e2e
            LEFT JOIN prg_pbsr_pick pp ON pp.emission_id = me.emission_id AND pp.e2e = t.e2e
            LEFT JOIN isr_fam  ifm ON ifm.arrival_id = t.arrival_id AND ifm.e2e = t.e2e AND ifm.rn = 1
            LEFT JOIN sbsr_fam sf  ON sf.arrival_id  = t.arrival_id AND sf.e2e  = t.e2e AND sf.rn  = 1
            LEFT JOIN pbsr_fam pf  ON pf.arrival_id  = t.arrival_id AND pf.e2e  = t.e2e AND pf.rn  = 1
            LEFT JOIN prg_status_class sc
                   ON sc.code = COALESCE(pp.status, pf.status, sp.status, sf.status, ip.status, ifm.status)
        ]]></createView>
    </changeSet>

    <!-- Member-grain current status: one row per crw_emission_member, joined
         over BOUNDED indexed paths only (member -> emission PK -> group PK,
         tx/validation via their (arrival_id, sequence) unique keys, response
         picks via the pick views). prg_report_due and prg_sla_pending read
         this instead of re-aggregating the tx-grain ext_tx_status stack; the
         no-emission family fallback is irrelevant here because a member row
         proves the emission exists. -->
    <changeSet id="003-member-status-view" author="dcre" runOnChange="true">
        <createView viewName="prg_member_status" replaceIfExists="true"><![CDATA[
            SELECT em.group_id, g.client, g.source_msg_id, m.emission_id, t.e2e,
                   COALESCE(pp.status, sp.status, ip.status,
                            CASE WHEN v.outcome = 'PASS' THEN 'CTV_PASS' ELSE v.outcome END) AS status,
                   COALESCE(sc.terminal, false) AS terminal
            FROM crw_emission_member m
            JOIN crw_emission em ON em.id = m.emission_id
            JOIN crw_emission_group g ON g.id = em.group_id
            JOIN tx_entry t ON t.arrival_id = em.arrival_id AND t.sequence = m.sequence
            LEFT JOIN validation_log v ON v.arrival_id = em.arrival_id AND v.sequence = m.sequence
            LEFT JOIN prg_isr_pick  ip ON ip.emission_id = m.emission_id AND ip.e2e = t.e2e
            LEFT JOIN prg_sbsr_pick sp ON sp.emission_id = m.emission_id AND sp.e2e = t.e2e
            LEFT JOIN prg_pbsr_pick pp ON pp.emission_id = m.emission_id AND pp.e2e = t.e2e
            LEFT JOIN prg_status_class sc ON sc.code = COALESCE(pp.status, sp.status, ip.status)
        ]]></createView>
    </changeSet>

    <!-- Due parents for the AGT trigger scan. Ratified semantics (plan Task 9,
         the deliberately-unfrozen block; ReportingSchemaIT case (c) is the
         contract): COMPLETE = every member of every batch of the parent is
         terminal (reports immediately); IDLE = newest batch-correlated response
         older than the 120s debounce (zero responses = debounce never started,
         not due); BOTH require at least one (client, e2e, status) tuple absent
         from the auto ledger rows. SCRUM-55 perf fix: completeness is derived
         from crw_emission_group.total_tx (the parent's expected total) vs the
         terminal member count aggregated once over prg_member_status, and the
         unreported delta is a hash left-anti join against the uq_ledger_auto
         tuple. NEVER re-introduce a per-parent correlated scan of the
         ext_tx_status stack here: that exact shape hung the live AGT trigger
         scan for 7+ minutes on a 12,001-tx parent (2026-07-16). -->
    <changeSet id="003-report-due-view" author="dcre" runOnChange="true">
        <createView viewName="prg_report_due" replaceIfExists="true"><![CDATA[
            WITH member_state AS (
                    SELECT ms.group_id,
                           count(*) FILTER (WHERE ms.terminal) AS terminal_members,
                           count(*) FILTER (WHERE ms.status IS NOT NULL
                                              AND l.e2e IS NULL) AS unreported
                    FROM prg_member_status ms
                    LEFT JOIN prg_delivery_ledger l
                           ON l.client = ms.client AND l.e2e = ms.e2e
                          AND l.status = ms.status AND l.manual_ref IS NULL
                    GROUP BY ms.group_id
            ),
            last_response AS (
                    SELECT e.group_id, max(r.updated_at) AS newest
                    FROM (SELECT emission_id, updated_at FROM isr_resp
                          WHERE emission_id IS NOT NULL
                          UNION ALL SELECT emission_id, updated_at FROM sbsr_resp
                          WHERE emission_id IS NOT NULL
                          UNION ALL SELECT emission_id, updated_at FROM pbsr_resp
                          WHERE emission_id IS NOT NULL) r
                    JOIN crw_emission e ON e.id = r.emission_id
                    GROUP BY e.group_id
            )
            SELECT g.client, g.source_msg_id,
                   CASE WHEN s.terminal_members = g.total_tx THEN 'COMPLETE' ELSE 'IDLE' END AS reason
            FROM crw_emission_group g
            JOIN member_state s ON s.group_id = g.id
            LEFT JOIN last_response lr ON lr.group_id = g.id
            WHERE s.unreported > 0
              AND (s.terminal_members = g.total_tx
                   OR (lr.newest IS NOT NULL AND lr.newest < now() - INTERVAL '120 seconds'))
        ]]></createView>
    </changeSet>

    <changeSet id="003-sla-pending-view" author="dcre" runOnChange="true">
        <createView viewName="prg_sla_pending" replaceIfExists="true"><![CDATA[
            SELECT ms.client, ms.e2e, em.outbound_msg_id, em.visible_at,
                   EXTRACT(EPOCH FROM (now() - em.visible_at)) / 3600 AS age_hours
            FROM prg_member_status ms
            JOIN crw_emission em ON em.id = ms.emission_id
            WHERE em.state = 'VISIBLE' AND em.visible_at IS NOT NULL AND NOT ms.terminal
        ]]></createView>
    </changeSet>

</databaseChangeLog>
