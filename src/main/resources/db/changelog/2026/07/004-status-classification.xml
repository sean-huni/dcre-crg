    <changeSet id="004-classify-acwc-unsupported" author="dcre">
        <!-- LIQUIBASE-SQL-EXCEPTION: conditional row existence has no typed precondition. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM prg_status_class WHERE code = 'ACWC'</sqlCheck>
        </preConditions>
        <insert tableName="prg_status_class">
            <column name="code" value="ACWC"/>
            <column name="terminal" valueBoolean="false"/>
            <column name="classification" value="UNSUPPORTED"/>
            <column name="reportable" valueBoolean="false"/>
        </insert>
        <rollback>
            <delete tableName="prg_status_class"><where>code = 'ACWC'</where></delete>
        </rollback>
    </changeSet>

    <changeSet id="004-classify-acwp-unsupported" author="dcre">
