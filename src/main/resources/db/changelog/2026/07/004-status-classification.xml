<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-55 corrective classification: the original applied catalogue
         distinguished terminality only. Keep that history immutable and add
         the business class plus the automatic-reporting decision here. -->
    <changeSet id="004-status-classification-column" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="prg_status_class" columnName="classification"/></not>
        </preConditions>
        <addColumn tableName="prg_status_class">
            <column name="classification" type="VARCHAR(32)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="prg_status_class" columnName="classification"/>
        </rollback>
    </changeSet>

    <changeSet id="004-status-reportable-column" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="prg_status_class" columnName="reportable"/></not>
        </preConditions>
        <addColumn tableName="prg_status_class">
            <column name="reportable" type="BOOLEAN"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="prg_status_class" columnName="reportable"/>
        </rollback>
    </changeSet>

    <changeSet id="004-classify-terminal-success" author="dcre">
        <update tableName="prg_status_class">
            <column name="classification" value="TERMINAL_SUCCESS"/>
            <column name="reportable" valueBoolean="true"/>
            <where>code IN ('ACSC', 'ACCC')</where>
        </update>
        <rollback>
            <update tableName="prg_status_class">
                <column name="classification" valueComputed="NULL"/>
                <column name="reportable" valueComputed="NULL"/>
                <where>code IN ('ACSC', 'ACCC')</where>
            </update>
        </rollback>
    </changeSet>

    <changeSet id="004-classify-terminal-non-success" author="dcre">
        <update tableName="prg_status_class">
            <column name="classification" value="TERMINAL_NON_SUCCESS"/>
            <column name="reportable" valueBoolean="true"/>
            <where>code IN ('RJCT', 'CANC')</where>
        </update>
        <rollback>
            <update tableName="prg_status_class">
                <column name="classification" valueComputed="NULL"/>
                <column name="reportable" valueComputed="NULL"/>
                <where>code IN ('RJCT', 'CANC')</where>
            </update>
        </rollback>
    </changeSet>

    <changeSet id="004-classify-accepted-non-terminal" author="dcre">
