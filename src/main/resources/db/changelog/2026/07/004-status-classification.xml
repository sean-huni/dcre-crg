        <rollback>
            <dropNotNullConstraint tableName="prg_status_class" columnName="reportable"
                                   columnDataType="BOOLEAN"/>
        </rollback>
    </changeSet>

    <!-- Unsupported and unknown Fintegrate response codes are retained raw
         and exposed for operations, but never enter an automatic PSR. Build
         from ext_tx_status so its deepest-leg choice and legacy no-emission
         fallback remain the single status-projection authority. -->
    <changeSet id="004-status-exception-view" author="dcre">
        <createView viewName="prg_status_exception" replaceIfExists="true"><![CDATA[
            SELECT x.client::VARCHAR(16) AS client,
                   COALESCE(x.source_msg_id, h.msg_id)::VARCHAR(35) AS source_msg_id,
                   x.outbound_msg_id::VARCHAR(64) AS outbound_msg_id,
                   x.e2e::VARCHAR(35) AS e2e, x.status::VARCHAR(32) AS status,
                   COALESCE(sc.classification, 'UNKNOWN')::VARCHAR(32) AS classification
            FROM ext_tx_status x
            JOIN tx_header h ON h.arrival_id = x.arrival_id
            LEFT JOIN prg_status_class sc ON sc.code = x.status
            WHERE x.status IS NOT NULL AND x.stage_rank > 1
              AND NOT COALESCE(sc.reportable, false)
        ]]></createView>
        <rollback><dropView viewName="prg_status_exception"/></rollback>
    </changeSet>

    <!-- An unsupported-only parent must not repeatedly become IDLE-due when
         the report writer is forbidden from emitting its status. Supported
         CTV_PASS and Fintegrate deltas retain the existing debounce rules. -->
    <changeSet id="004-report-due-supported-only" author="dcre">
        <createView viewName="prg_report_due" replaceIfExists="true"><![CDATA[
            WITH member_state AS (
                    SELECT ms.group_id,
                           count(*) FILTER (WHERE ms.terminal) AS terminal_members,
                           count(*) FILTER (WHERE ms.status IS NOT NULL
                                              AND (ms.status = 'CTV_PASS'
                                                   OR COALESCE(sc.reportable, false))
                                              AND l.e2e IS NULL) AS unreported
                    FROM prg_member_status ms
                    LEFT JOIN prg_status_class sc ON sc.code = ms.status
                    LEFT JOIN prg_delivery_ledger l
                           ON l.client = ms.client AND l.e2e = ms.e2e
                          AND l.status = ms.status AND l.manual_ref IS NULL
                    GROUP BY ms.group_id
            ),
            last_response AS (
                    SELECT e.group_id, max(r.updated_at) AS newest
                    FROM (SELECT emission_id, updated_at FROM isr_resp
                          WHERE emission_id IS NOT NULL
                          UNION ALL SELECT emission_id, updated_at FROM sbsr_resp
                          WHERE emission_id IS NOT NULL
                          UNION ALL SELECT emission_id, updated_at FROM pbsr_resp
                          WHERE emission_id IS NOT NULL) r
                    JOIN crw_emission e ON e.id = r.emission_id
                    GROUP BY e.group_id
            )
            SELECT g.client, g.source_msg_id,
                   CASE WHEN s.terminal_members = g.total_tx THEN 'COMPLETE' ELSE 'IDLE' END AS reason
            FROM crw_emission_group g
            JOIN member_state s ON s.group_id = g.id
            LEFT JOIN last_response lr ON lr.group_id = g.id
            WHERE s.unreported > 0
              AND (s.terminal_members = g.total_tx
                   OR (lr.newest IS NOT NULL AND lr.newest < now() - INTERVAL '120 seconds'))
        ]]></createView>
        <rollback>
            <createView viewName="prg_report_due" replaceIfExists="true"><![CDATA[
                WITH member_state AS (
                        SELECT ms.group_id,
                               count(*) FILTER (WHERE ms.terminal) AS terminal_members,
                               count(*) FILTER (WHERE ms.status IS NOT NULL
                                                  AND l.e2e IS NULL) AS unreported
                        FROM prg_member_status ms
                        LEFT JOIN prg_delivery_ledger l
                               ON l.client = ms.client AND l.e2e = ms.e2e
                              AND l.status = ms.status AND l.manual_ref IS NULL
                        GROUP BY ms.group_id
                ),
                last_response AS (
                        SELECT e.group_id, max(r.updated_at) AS newest
                        FROM (SELECT emission_id, updated_at FROM isr_resp
                              WHERE emission_id IS NOT NULL
                              UNION ALL SELECT emission_id, updated_at FROM sbsr_resp
                              WHERE emission_id IS NOT NULL
                              UNION ALL SELECT emission_id, updated_at FROM pbsr_resp
                              WHERE emission_id IS NOT NULL) r
                        JOIN crw_emission e ON e.id = r.emission_id
                        GROUP BY e.group_id
                )
                SELECT g.client, g.source_msg_id,
                       CASE WHEN s.terminal_members = g.total_tx THEN 'COMPLETE' ELSE 'IDLE' END AS reason
                FROM crw_emission_group g
                JOIN member_state s ON s.group_id = g.id
                LEFT JOIN last_response lr ON lr.group_id = g.id
                WHERE s.unreported > 0
                  AND (s.terminal_members = g.total_tx
                       OR (lr.newest IS NOT NULL AND lr.newest < now() - INTERVAL '120 seconds'))
            ]]></createView>
        </rollback>
    </changeSet>

</databaseChangeLog>
