            <column name="classification" value="PENDING_INTERIM"/>
            <column name="reportable" valueBoolean="true"/>
            <where>code IN ('RCVD', 'PDNG', 'PART', 'PATC')</where>
        </update>
        <rollback>
            <update tableName="prg_status_class">
                <column name="classification" valueComputed="NULL"/>
