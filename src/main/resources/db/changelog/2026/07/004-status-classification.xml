    <changeSet id="004-status-classification-not-null" author="dcre">
        <!-- LIQUIBASE-SQL-EXCEPTION: column nullability has no typed precondition. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="YES">
                SELECT is_nullable FROM information_schema.columns
                WHERE table_schema = current_schema() AND table_name = 'prg_status_class'
                  AND column_name = 'classification'
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="prg_status_class" columnName="classification"
                              columnDataType="VARCHAR(32)"/>
        <rollback>
            <dropNotNullConstraint tableName="prg_status_class" columnName="classification"
                                   columnDataType="VARCHAR(32)"/>
        </rollback>
    </changeSet>

    <changeSet id="004-status-reportable-not-null" author="dcre">
        <!-- LIQUIBASE-SQL-EXCEPTION: column nullability has no typed precondition. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="YES">
                SELECT is_nullable FROM information_schema.columns
                WHERE table_schema = current_schema() AND table_name = 'prg_status_class'
