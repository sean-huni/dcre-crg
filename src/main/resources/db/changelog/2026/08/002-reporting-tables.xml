        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="prg_delivery_ledger"/></not>
        </preConditions>
        
        <createTable tableName="prg_delivery_ledger">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="report_id" type="UUID"><constraints nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="manual_ref" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="prg_delivery_ledger" indexName="ix_ledger_report">
            <column name="report_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="prg_delivery_ledger"/>
        </rollback>
    </changeSet>

    <changeSet id="crg-v1-ledger-auto-guard" author="dcre">
        <!-- A-82: this changeset gained a re-run guard AFTER it had already been applied,
             which changes the enclosing checksum without changing one byte of the DDL
             below. ANY rather than a pinned value: kind-dcre-dev stored 9:938c46b0c9c9e1e28b34caee29180be2,
             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="prg_delivery_ledger" indexName="uq_ledger_auto"/></not>
        </preConditions>
        
        <!-- LIQUIBASE-SQL-EXCEPTION: a PARTIAL unique index (WHERE predicate) has no
             typed Liquibase tag. The predicate is the point of the index: manual
             overrides must bypass the auto-send guard. -->
        <sql>CREATE UNIQUE INDEX uq_ledger_auto ON prg_delivery_ledger (client, e2e, status) WHERE manual_ref IS NULL;</sql>
        <rollback>
            <dropIndex tableName="prg_delivery_ledger" indexName="uq_ledger_auto"/>
        </rollback>
    </changeSet>

    <!-- CRG-owned read indexes on relations OWNED BY OTHER SERVICES. CRG creates the
         index but not the table, which is deliberate: the index exists purely for
         CRG's projection stack and no other service would know to keep it. They are
         named ix_prg_* so their owner is unambiguous on a shared database, and they
         are the reason part 2 must run after the writers have created their tables.

         They exist for the set-based projection stack in part 4: one window pass per
         response table plus
         hash joins, replacing a correlated per-row probe that executed as nested-loop
         lookups and hung a live trigger scan for over seven minutes on a 12,001-tx
         parent. Named ix_prg_* so their owner is unambiguous on a shared database. -->
