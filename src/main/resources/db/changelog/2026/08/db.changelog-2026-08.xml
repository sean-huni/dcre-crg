    <!-- Sub-master for 2026/08: the month that carries the CRG v1 baseline.
         The root master includes months, never individual changesets, so a new month
         is one line in the root and every changeset within a month stays ordered
         here.

         The order is the dependency order and is not cosmetic: part 4's views resolve
         against part 3's catalogue at CREATE time, and CockroachDB resolves a view
         body when the view is created rather than when it is queried. -->

    <include file="db/changelog/2026/08/001-batch-metadata.xml"/>
    <include file="db/changelog/2026/08/002-reporting-tables.xml"/>
    <include file="db/changelog/2026/08/003-status-classification.xml"/>
    <include file="db/changelog/2026/08/004-reporting-views.xml"/>

