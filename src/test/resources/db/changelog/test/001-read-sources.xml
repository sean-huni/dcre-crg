<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================================
         TEST FIXTURE ONLY. Nothing in this file ships: it lives under src/test and is
         reached only through db.changelog-test-master.xml.

         CRG READS nine relations it does not own and, from v1 on, does not create.
         Its own integration tests still need them to exist, because CRG's views and
         ix_prg_* indexes resolve their targets at CREATE time. In production the
         owning services create them; here this fixture stands in for those services,
         and it must run BEFORE the production master for the same reason.

         Owners, all single-writer per R-04:
           tx_header, tx_entry .......................... CRR
           validation_log ............................... CTV
           isr_resp / sbsr_resp / pbsr_resp ............. CIX / CSX / CPX
           crw_emission_group / crw_emission /
           crw_emission_member .......................... CRW

         THIS IS A HAND-MAINTAINED MIRROR OF ANOTHER REPOSITORY'S DDL, which is a
         drift class: CRG's suite can stay green against a shape the owner has already
         changed, and nothing here would notice. The bodies below were extracted
         mechanically from the owners' committed v1 baselines rather than retyped, and
         the owners' own re-run preconditions were stripped because this fixture runs
         once against an empty test database. The durable fix is a shared test-fixture
         artifact published by the owners; until that exists, treat any owner schema
         change as requiring a matching edit here.
         ============================================================================ -->

    <changeSet id="crg-testfixture-tx-header" author="dcre">
        <createTable tableName="tx_header">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_header_arrival"/>
            </column>
            <column name="msg_id_raw" type="VARCHAR(35)">
                <constraints nullable="false"/>
            </column>
            <column name="msg_id" type="VARCHAR(35)">
                <constraints nullable="false"/>
            </column>
            <column name="created_ts" type="VARCHAR(14)">
                <constraints nullable="false"/>
            </column>
            <column name="tx_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="initg_pty" type="VARCHAR(35)">
                <constraints nullable="false"/>
            </column>
            <column name="business_date" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="client_token" type="VARCHAR(16)"/>
            <column name="layout_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="tx_header"/>
        </rollback>
    </changeSet>

